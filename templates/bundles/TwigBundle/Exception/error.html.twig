<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        {% if status_code == 404 %}Page introuvable
        {% elseif status_code == 403 %}Accès refusé
        {% else %}Une erreur est survenue{% endif %}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <header class="topbar"><div class="inner"><a class="brand" href="/">Accueil</a></div></header>
    <main>
        <div class="card empty" style="text-align:center;padding:48px 24px">
            <p style="font-size:3.2rem;font-weight:700;color:var(--navy);margin:0">{{ status_code }}</p>
            <h1 style="margin:8px 0 12px">
                {% if status_code == 404 %}Page introuvable
                {% elseif status_code == 403 %}Accès refusé
                {% else %}Une erreur est survenue{% endif %}
            </h1>
            <p class="muted">
                {% if status_code == 404 %}Le lien est incorrect ou la page n'existe plus.
                {% elseif status_code == 403 %}Vous n'avez pas le droit d'ouvrir cette page.
                {% else %}Veuillez réessayer dans quelques instants.{% endif %}
            </p>
            <a class="btn" href="/">Retour à l'accueil</a>
        </div>
    </main>
</body>
</html>
