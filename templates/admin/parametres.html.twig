{% extends 'base.html.twig' %}
{% block title %}Ma boutique{% endblock %}

{% block body %}
<h1>Ma boutique</h1>
<p class="muted">Ces informations apparaissent sur votre boutique en ligne.</p>

{% if boutique.logo %}
    <p style="text-align:center"><img src="{{ boutique.logo }}" alt="Logo" style="width:90px;height:90px;object-fit:cover;border-radius:50%;border:3px solid var(--navy)"></p>
{% endif %}

{{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn block">Enregistrer</button>
{{ form_end(form) }}

<p class="muted">Lien de votre boutique à partager à vos clients :<br>
<a href="{{ path('shop_catalogue', {slug: boutique.slug}) }}" target="_blank" rel="noopener">{{ url('shop_catalogue', {slug: boutique.slug}) }}</a></p>
{% endblock %}
