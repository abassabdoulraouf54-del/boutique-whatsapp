<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛍️</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page">
<div class="login-wrap">

    <section class="login-side">
        <div class="login-side-inner">
            <span class="login-mark">🛍️</span>
            <h1>Espace commerçant</h1>
            <p class="login-lead">Gérez votre boutique en ligne simplement, depuis votre téléphone ou votre ordinateur.</p>
            <ul class="login-points">
                <li><span>📦</span> Produits, photos et stock</li>
                <li><span>💬</span> Commandes envoyées sur WhatsApp</li>
                <li><span>📊</span> Suivi des ventes en temps réel</li>
            </ul>
        </div>
        <small class="login-side-foot">© {{ 'now'|date('Y') }} · Boutique en ligne</small>
    </section>

    <section class="login-main">
        <form method="post" class="login-form" novalidate>
            <h2>Connexion</h2>
            <p class="login-sub">Accédez à l'administration de votre boutique</p>

            {% if error %}
                <div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="flash">Vous êtes déjà connecté en tant que {{ app.user.userIdentifier }}. <a href="{{ path('admin_dashboard') }}">Ouvrir le tableau de bord</a></div>
            {% endif %}

            <div class="field">
                <label for="username">Adresse email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" placeholder="vous@exemple.com" autocomplete="email" required autofocus>
            </div>

            <div class="field">
                <label for="password">Mot de passe</label>
                <div class="pass-wrap">
                    <input type="password" id="password" name="_password" placeholder="Votre mot de passe" autocomplete="current-password" required>
                    <button type="button" class="pass-toggle" id="pass-toggle" aria-label="Afficher le mot de passe">Afficher</button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn block login-submit">Se connecter</button>

            <p class="login-help">Mot de passe oublié ? Contactez votre prestataire pour le réinitialiser.</p>
        </form>
    </section>

</div>

<script>
    (function () {
        var champ = document.getElementById('password');
        var bouton = document.getElementById('pass-toggle');
        if (!champ || !bouton) { return; }
        bouton.addEventListener('click', function () {
            var cache = champ.type === 'password';
            champ.type = cache ? 'text' : 'password';
            bouton.textContent = cache ? 'Masquer' : 'Afficher';
            bouton.setAttribute('aria-label', cache ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
        });
    })();
</script>
</body>
</html>
