{% extends 'base.html.twig' %}
{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
<h1>Modifier la catégorie</h1>
{{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn">Mettre à jour</button>
{{ form_end(form) }}

<form method="post" action="{{ path('app_categorie_delete', {id: categorie.id}) }}" onsubmit="return confirm('Supprimer cette catégorie ?');" style="margin-top:16px">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
    <button type="submit" class="btn danger">Supprimer</button>
</form>
<p><a class="btn secondary" href="{{ path('app_categorie_index') }}">← Retour à la liste</a></p>
{% endblock %}
