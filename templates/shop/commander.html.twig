{% extends 'shop/layout.html.twig' %}
{% block title %}Commander - {{ boutique.nom }}{% endblock %}

{% block body %}
<h1>Finaliser ma commande</h1>

{% for e in erreurs %}
    <div class="flash error">{{ e }}</div>
{% endfor %}

<div class="card">
    <h3>Récapitulatif</h3>
    <ul class="recap">
        {% for l in lignes %}
            <li>{{ l.qte }} x {{ l.produit.nom }} <strong>{{ l.sous|number_format(0, ',', ' ') }} FCFA</strong></li>
        {% endfor %}
        <li>Livraison <strong>{{ frais|number_format(0, ',', ' ') }} FCFA</strong></li>
        <li class="grand">Total <strong>{{ total|number_format(0, ',', ' ') }} FCFA</strong></li>
    </ul>
</div>

<form method="post" class="card" id="form-commande">
    <input type="hidden" name="_token" value="{{ csrf_token('commande') }}">
    <div>
        <label for="nom">Votre nom</label>
        <input type="text" id="nom" name="nom" value="{{ data.nom }}" autocomplete="name" minlength="2" required>
    </div>
    <div>
        <label for="telephone">Téléphone</label>
        <input type="tel" id="telephone" name="telephone" value="{{ data.telephone }}" inputmode="tel"
               autocomplete="tel" minlength="8" maxlength="20" pattern="[0-9+\s]{8,20}"
               placeholder="01 97 00 00 00" required>
        <small class="muted">Le vendeur vous appelle ou vous écrit sur ce numéro pour la livraison.</small>
    </div>
    <div>
        <label for="adresse">Quartier / adresse de livraison</label>
        <textarea id="adresse" name="adresse" rows="3" autocomplete="street-address" minlength="5" required>{{ data.adresse }}</textarea>
    </div>

    {% if boutique.momoInfo %}
    <div>
        <label>Mode de paiement</label>
        <div class="pay-options">
            <label class="pay"><input type="radio" name="paiement" value="livraison" checked><span>Payer à la livraison</span></label>
            <label class="pay"><input type="radio" name="paiement" value="momo"><span>Mobile Money</span></label>
        </div>
        <div class="momo-box" id="momo-infos" hidden>
            <strong>Paiement par Mobile Money</strong>
            <p>Après validation, envoyez <b>{{ total|number_format(0, ',', ' ') }} FCFA</b> à :</p>
            <p class="momo-num">{{ boutique.momoInfo|nl2br }}</p>
            <p>Vous enverrez la preuve du transfert sur WhatsApp à l'étape suivante.</p>
        </div>
    </div>
    {% endif %}

    <button type="submit" class="btn block" id="btn-valider">Valider la commande</button>
</form>

<script>
(() => {
    const form = document.getElementById('form-commande');
    const box = document.getElementById('momo-infos');
    const bouton = document.getElementById('btn-valider');
    const texte = bouton.textContent;

    const maj = () => {
        const choix = form.elements['paiement'];
        if (box) box.hidden = !(choix && choix.value === 'momo');
    };
    form.addEventListener('change', maj);
    maj();

    form.addEventListener('submit', () => {
        bouton.disabled = true;
        bouton.textContent = 'Envoi en cours…';
    });
    window.addEventListener('pageshow', () => {
        bouton.disabled = false;
        bouton.textContent = texte;
    });
})();
</script>
{% endblock %}
