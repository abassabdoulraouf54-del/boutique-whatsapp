{% extends 'shop/layout.html.twig' %}

{% block body %}
<section class="hero">
    <span class="eyebrow" id="greet">Boutique en ligne</span>
    <p class="hello" aria-label="Bienvenue"><span class="hello-w" aria-hidden="true">Welcome</span><span class="hello-w" aria-hidden="true">Bienvenue</span></p>
    <h1>{{ boutique.nom }}</h1>
    <p>{{ boutique.slogan ?: 'Choisissez vos produits et commandez en 2 minutes.' }}</p>
    <form class="search" method="get" action="{{ path('shop_catalogue', {slug: boutique.slug}) }}">
        {% if cat %}<input type="hidden" name="cat" value="{{ cat }}">{% endif %}
        <input type="search" name="q" value="{{ q }}" placeholder="Rechercher un produit…" aria-label="Rechercher">
        <button type="submit">Rechercher</button>
    </form>
</section>

<div class="trust">
    <div><span>⚡</span>Commande en 2 minutes</div>
    <div><span>💬</span>Confirmation sur WhatsApp</div>
    <div><span>🚚</span>Livraison à domicile</div>
</div>

{% if categories %}
<nav class="chips">
    <a class="chip {{ cat == 0 ? 'active' }}" href="{{ path('shop_catalogue', {slug: boutique.slug}) }}">Tout</a>
    {% for c in categories %}
        <a class="chip {{ cat == c.id ? 'active' }}" href="{{ path('shop_catalogue', {slug: boutique.slug, cat: c.id}) }}">{{ c.nom }}</a>
    {% endfor %}
</nav>
{% endif %}

{% if produits %}
<div class="sec-titre">
    <h2>{{ cat ? 'Produits de la catégorie' : 'Nos produits' }}</h2>
    <small>{{ produits|length }} article{{ produits|length > 1 ? 's' : '' }}</small>
</div>
<div class="grid">
    {% for p in produits %}
    <article class="product">
        <a class="thumb" href="{{ path('shop_produit', {slug: boutique.slug, id: p.id}) }}">
            {% if p.image %}<img src="{{ p.image }}" alt="{{ p.nom }}" loading="lazy">{% else %}<span class="ph">🛍️</span>{% endif %}
            {% if p.stock <= 0 %}<span class="tag out">Épuisé</span>{% elseif p.stock <= 3 %}<span class="tag">Dernières pièces</span>{% endif %}
        </a>
        <div class="info">
            <h3><a href="{{ path('shop_produit', {slug: boutique.slug, id: p.id}) }}">{{ p.nom }}</a></h3>
            {% if p.description %}<p class="desc">{{ p.description|slice(0, 70) }}{{ p.description|length > 70 ? '…' }}</p>{% endif %}
            <p class="price">{{ p.prix|number_format(0, ',', ' ') }} FCFA</p>
            {% if p.stock > 0 %}
                <form method="post" action="{{ path('shop_panier_ajouter', {slug: boutique.slug, id: p.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                    <button type="submit" class="btn block">Ajouter au panier</button>
                </form>
            {% else %}
                <p class="soldout">Indisponible</p>
            {% endif %}
        </div>
    </article>
    {% endfor %}
</div>
{% else %}
<div class="card empty">
    {% if q %}
        <p>Aucun résultat pour « {{ q }} ».</p>
        <a class="btn secondary" href="{{ path('shop_catalogue', {slug: boutique.slug}) }}">Voir tous les produits</a>
    {% else %}
        <p>Aucun produit disponible pour le moment.</p>
    {% endif %}
</div>
{% endif %}
{% if produits %}
<section class="steps">
    <h2>Comment commander ?</h2>
    <div class="step"><b>1</b><strong>Choisissez</strong><p>Ajoutez vos produits au panier.</p></div>
    <div class="step"><b>2</b><strong>Validez</strong><p>Indiquez votre adresse de livraison.</p></div>
    <div class="step"><b>3</b><strong>Confirmez sur WhatsApp</strong><p>Le vendeur confirme et organise la livraison.</p></div>
</section>
{% endif %}
<script src="/js/welcome.js"></script>
{% endblock %}
